{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Irori needs dialogs, dragging/closing/destroying its own windows, and its own commands; everything else stays closed.",
  "windows": [
    "main",
    "w*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default"
  ]
}