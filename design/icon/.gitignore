# All output of the design process lands here, and none of it goes into git.
# Anything one command can regenerate doesn't belong in version control:
#   node design/icon/hearth.gen.mjs      mark → out/hearth{,-round}.svg
#   node design/icon/appicon.gen.mjs     app icon → out/irori-app.svg
#   node design/icon/render.mjs <svg>    → out/*.png
#   node design/icon/export.mjs          published copies → assets/logo/
# What goes into git is the "sources" and the "published copies": generators, design doc,
# assets/logo/, src-tauri/icons/.
out/
